# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tests
.pytest_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local scratch audio (keep fixtures + the bundled clone reference tracked)
*.wav
!tests/fixtures/*.wav
!assets/ref-fr-female.wav

# Real config files — keep only the committed examples.
*config.json
!*config.json.example
settings.yaml
!settings.yaml.example

# Private living working files (handoff notes / plans, kept out of the repo).
/todo.md
/.private/

# ASR transcript caches (sidecars next to audio)
*.wav.txt

# local-only tooling & secrets (root-level helper scripts, secrets)
/*.sh
.secrets/
.pypirc

# `.githooks/` is NOT ignored, and used to be — grouped with the secrets, in a
# line whose own comment called it "local-only tooling". It holds no secret: it
# holds the pre-push gate, whose first instruction is "Enable once per clone:
# git config core.hooksPath .githooks", which cannot be followed from a clone
# that does not contain it. Every sibling package in this suite tracks theirs.

# Local secrets (HF token, etc.) — never commit.
s.yaml
*.secret.yaml

# Generated landscape CSVs (derived from LANDSCAPE.md / PAYSAGE.md star tables)
